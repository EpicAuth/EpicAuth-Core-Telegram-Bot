{
  "name": "epicauth-seller-bot",
  "module": "src/index.ts",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "typecheck": "tsc --noEmit",
    "test:store": "bun run scripts/smoke-store.ts",
    "test:loader": "bun run scripts/smoke-loader.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "lines": "cloc . --exclude-dir=node_modules,dist,src/generated,prisma/migrations --exclude-lang=JSON,Markdown,HTML"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "^24.10.1",
    "cloc": "^2.4.0-cloc",
    "prisma": "7.9.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@grammyjs/conversations": "^2.1.0",
    "@libsql/client": "^0.18.0",
    "@prisma/adapter-libsql": "7.9.1",
    "@prisma/client": "7.9.1",
    "axios": "^1.10.0",
    "chalk": "^5.4.1",
    "dotenv": "^17.2.3",
    "grammy": "^1.36.3"
  }
}